@"
# Python cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Database files
instance/*.db
*.sqlite
*.sqlite3

# Environment variables
.env
.env.*

# IDE settings
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Testing and logs
.pytest_cache/
.coverage
htmlcov/
*.log
"@ | Set-Content -Encoding utf8 .gitignore